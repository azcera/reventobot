{
  "name": "bot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev:dashboard": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:server && npm run build:browser-modules && vite build",
    "test": "npm run build:test && node --test dist/tests/*.test.js",
    "pretest:dashboard": "npm run build && npm run build:test",
    "test:dashboard": "playwright test",
    "build:server": "tsc -p tsconfig.json",
    "build:browser-modules": "node dist/scripts/build.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json",
    "build:test": "tsc -p tsconfig.test.json && node dist/scripts/build.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "teleproto": "^1.229.0"
  },
  "overrides": {
    "undici": "^6.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
