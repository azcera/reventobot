# Существующие подключения бота
TOKEN=
GUILD_ID=
DATABASE_URL=

# OAuth2: приложение того же Discord-бота, Developer Portal → OAuth2
CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Если секрет уже сохранён как CLIENT_SECRET, код использует его; дублировать не нужно.
# Без завершающего /. Для внешнего доступа обязателен HTTPS.
DASHBOARD_URL=https://revento-bot--azcera.replit.app
PORT=3000
# Необязательно: доступ только администраторам из списка (Discord user ID через запятую).
# При непустом списке включите ID владельца, если ему тоже нужен доступ.
DASHBOARD_ALLOWED_USER_IDS=
