# Существующие подключения бота
TOKEN=
GUILD_ID=
DATABASE_URL=

# OAuth2: приложение того же Discord-бота, Developer Portal → OAuth2
CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Если секрет уже сохранён как CLIENT_SECRET, код использует его; дублировать не нужно.
# Без завершающего /. Для внешнего доступа обязателен HTTPS.
DASHBOARD_URL=https://revento-bot--azcera.replit.app
PORT=3000
# Необязательно: доступ только администраторам из списка (Discord user ID через запятую).
# При непустом списке включите ID владельца, если ему тоже нужен доступ.
DASHBOARD_ALLOWED_USER_IDS=

TG_API_ID=
TG_API_HASH=
TG_SESSION=
SUPABASE_URL=
DISCORD_NOTIFICATION_CHANNEL_ID=
TG_NOTIFICATION_BOT_TOKEN=
TG_NOTIFICATION_CHAT_ID=
MAJESTIC_SESSION_ID=
MAJESTIC_SERVER=
MAJESTIC_CHARACTER_ID=
FAMILY_WARS_API_KEY=

# Каналы, роли и переключатели функций хранятся в БД и редактируются в дашборде.
# При первом запуске новой версии старые значения этих настроек из env
# переносятся в БД однократно, без перезаписи сохранённых значений.
